# Absolute production URL (used for canonical URLs, sitemap, robots and Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.cz

# Contact form — Resend (https://resend.com). Without these the form reports
# that the message was NOT sent (HTTP 503) instead of faking success.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend, e.g. "Portfolio <web@your-domain.cz>"
CONTACT_FROM_EMAIL=
